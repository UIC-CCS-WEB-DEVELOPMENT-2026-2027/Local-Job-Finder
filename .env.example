# Localified · environment variables
# Copy to `.env.local` for Vite, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase (required for production / Vercel)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: local json-server fallback when Supabase is not configured
# VITE_JOBS_API_URL=http://localhost:3001/jobs
